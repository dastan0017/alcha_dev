# =============================================================================
# alcha.dev — environment variables (copy to .env and fill in real values)
# `pnpm dev` reads root .env for docker-compose; each app also reads its own .env.
# For local dev you can keep everything in this single root .env file.
# =============================================================================

# ------------------------------------------------------------------ Postgres --
POSTGRES_USER=alcha
POSTGRES_PASSWORD=alcha
POSTGRES_DB=alcha
POSTGRES_PORT=5432

# Consumed by Prisma (apps/api). Matches the docker-compose postgres service.
DATABASE_URL=postgresql://alcha:alcha@localhost:5432/alcha?schema=public

# ----------------------------------------------------------------------- API --
# apps/api runs on this port
PORT=4000
API_URL=http://localhost:4000
# Public base used by the API when it builds absolute media/OG URLs
API_PUBLIC_URL=http://localhost:4000

# Auth — generate strong secrets in production: `openssl rand -base64 48`
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Lifetime of the draft-preview tokens the CRM editor hands to the site iframe
PREVIEW_TOKEN_TTL=2h

# CORS — comma-separated list of allowed origins (web + crm)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Seed admin (created by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@alcha.dev
SEED_ADMIN_PASSWORD=changeme123

# ------------------------------------------------------ ISR revalidation ------
# Shared secret between API and web /api/revalidate endpoint
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Where the API sends revalidate webhooks (the public web app)
WEB_URL=http://localhost:3000

# ---------------------------------------------- S3 / MinIO (media uploads) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alcha-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public URL assets are served from (MinIO console maps to :9000; in prod a CDN)
S3_PUBLIC_URL=http://localhost:9000/alcha-media
# Use path-style addressing (required for MinIO, false for real AWS S3)
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ------------------------------------------- Telegram lead notifications ------
# Optional — leave empty to disable. Create a bot via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------- Web app ----
# apps/web (Next.js) — public, must be prefixed NEXT_PUBLIC_ to reach the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only fetch base (internal network in prod; defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000
# Analytics — leave empty in dev (snippets stay off)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Search console verification tokens (rendered as <meta> when set)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Origin allowed to drive the draft preview bridge (the CRM that embeds the site)
CRM_URL=http://localhost:5173

# ----------------------------------------------------------------- CRM app ----
# apps/crm (Vite) — must be prefixed VITE_ to reach the browser
VITE_API_URL=http://localhost:4000
# Public site the «Сайт» editor embeds in draft preview mode
VITE_SITE_URL=http://localhost:3000
