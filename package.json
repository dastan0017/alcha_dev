{
  "name": "alcha-dev",
  "version": "1.0.0",
  "private": true,
  "description": "alcha.dev — portfolio & services website + CRM + API monorepo",
  "author": "Dastan Rakhmanzhanov <hello@alcha.dev>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm db:up && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:up": "docker compose up -d postgres",
    "db:up:all": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @alcha/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @alcha/api db:migrate:deploy",
    "db:seed": "pnpm --filter @alcha/api db:seed",
    "db:reset": "pnpm --filter @alcha/api db:reset",
    "db:studio": "pnpm --filter @alcha/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
