// alcha.dev — Prisma schema.
// Translation-table pattern: a base row + `*Translation` rows keyed by locale,
// with a unique (parentId, locale). Every orderable entity has `sortOrder`,
// every publishable one a `published` flag, and timestamps everywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ru
  en
}

enum LeadStatus {
  new
  in_progress
  paid
  closed
}

enum ProjectBadge {
  work // client / work project
  own // own product (gets the gradient treatment)
}

enum UserRole {
  ADMIN
}

enum SeoPage {
  home
  about
}

// ----------------------------------------------------------------- Auth ------

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               UserRole @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ------------------------------------------------------- Site settings --------

// Singleton — language-neutral contacts, socials, CV and analytics.
model SiteSettings {
  id              String   @id @default(cuid())
  email           String   @default("hello@alcha.dev")
  telegram        String   @default("")
  whatsapp        String   @default("")
  github          String   @default("")
  linkedin        String   @default("")
  instagram       String   @default("")
  cvUrl           String   @default("")
  addressLocality String   @default("Bishkek")
  addressRegion   String   @default("Chuy")
  addressCountry  String   @default("KG")
  priceRange      String   @default("$300+")
  gaId            String?
  yandexMetrikaId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --------------------------------------------------------- Site chrome --------

// Singleton — nav, footer and shared button labels rendered on every page.
model SiteChrome {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations SiteChromeTranslation[]
}

model SiteChromeTranslation {
  id                    String     @id @default(cuid())
  siteChrome            SiteChrome @relation(fields: [siteChromeId], references: [id], onDelete: Cascade)
  siteChromeId          String
  locale                Locale
  navWorks              String     @default("")
  navPricing            String     @default("")
  navAbout              String     @default("")
  navCta                String     @default("")
  /// Compact header CTA on narrow screens.
  navCtaShort           String     @default("")
  footerTagline         String     @default("")
  footerNavHeading      String     @default("")
  footerContactsHeading String     @default("")
  footerRights          String     @default("")
  footerMadeIn          String     @default("")
  /// Works card link, e.g. "Смотреть кейс".
  viewCaseLabel         String     @default("")
  /// Case-page breadcrumb back to the works list.
  allWorksLabel         String     @default("")
  backToHomeLabel       String     @default("")
  roleLabel             String     @default("")
  stackLabel            String     @default("")
  whatWasDoneLabel      String     @default("")
  /// Hint under the pricing carousel on mobile.
  pricingSwipeHint      String     @default("")

  @@unique([siteChromeId, locale])
}

// ---------------------------------------------------- Home editorial ----------

// Singleton — hero, section headings and the shared dark CTA banner.
model HomeContent {
  id             String                   @id @default(cuid())
  published      Boolean                  @default(true)
  /// Sections the owner hid in the visual editor (HomeSectionKey values).
  hiddenSections String[]                 @default([])
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  translations   HomeContentTranslation[]
}

model HomeContentTranslation {
  id                     String      @id @default(cuid())
  homeContent            HomeContent @relation(fields: [homeContentId], references: [id], onDelete: Cascade)
  homeContentId          String
  locale                 Locale
  eyebrow                String
  heroTitle              String
  heroSubtitle           String
  heroBullets            String[]
  heroNote               String      @default("")
  heroCtaPrimary         String
  heroCtaSecondary       String
  trustLine              String
  servicesEyebrow        String      @default("")
  servicesHeading        String
  servicesLede           String      @default("")
  servicesSecondaryLabel String      @default("")
  worksEyebrow           String      @default("")
  worksHeading           String
  worksLede              String      @default("")
  worksLinkLabel         String      @default("")
  pricingEyebrow         String      @default("")
  pricingHeading         String
  pricingNote            String
  pricingFootnote        String      @default("")
  ctaTitle               String
  ctaSubtitle            String
  ctaTelegramLabel       String
  ctaCvLabel             String

  @@unique([homeContentId, locale])
}

// ------------------------------------------------------------ Services --------

model Service {
  id           String               @id @default(cuid())
  number       String
  sortOrder    Int                  @default(0)
  published    Boolean              @default(true)
  /// The one highlighted "core strength" service rendered as the large card.
  featured     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ServiceTranslation[]
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String
  locale      Locale
  title       String
  description String
  /// Pill label on the featured card, e.g. "МОЯ ГЛАВНАЯ СИЛА".
  badge       String   @default("")
  /// Checklist rendered with purple ticks.
  bullets     String[]
  /// Optional mono tech line, e.g. "React · Next.js · TypeScript".
  techLine    String   @default("")

  @@unique([serviceId, locale])
}

// ------------------------------------------------------------ Projects --------

model Project {
  id           String               @id @default(cuid())
  slug         String               @unique
  badgeType    ProjectBadge
  sortOrder    Int                  @default(0)
  showOnHome   Boolean              @default(false)
  showOnAbout  Boolean              @default(false)
  published    Boolean              @default(false)
  screenshots  String[]
  coverImage   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]

  @@index([sortOrder])
}

model ProjectTranslation {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  locale         Locale
  title          String
  badge          String
  /// Product-type tag on the works card, e.g. "СОБСТВЕННЫЙ ПРОДУКТ" (empty = hidden).
  typeTag        String   @default("")
  metaLine       String
  /// Mono highlight line of concrete facts on the works card.
  factsLine      String   @default("")
  role           String   @default("")
  description    String
  pills          String[]
  bullets        String[]
  techChips      String[]
  seoTitle       String   @default("")
  seoDescription String   @default("")

  @@unique([projectId, locale])
}

// ------------------------------------------------------------- Pricing --------

model PricingPlan {
  id           String                   @id @default(cuid())
  sortOrder    Int                      @default(0)
  highlighted  Boolean                  @default(false)
  published    Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations PricingPlanTranslation[]
}

model PricingPlanTranslation {
  id             String      @id @default(cuid())
  plan           PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  locale         Locale
  name           String
  priceLabel     String
  termLine       String
  highlightLabel String      @default("")
  description    String
  features       String[]

  @@unique([planId, locale])
}

// ---------------------------------------------------------- Experience --------

model Experience {
  id           String                  @id @default(cuid())
  company      String
  sortOrder    Int                     @default(0)
  published    Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  experienceId String
  locale       Locale
  role         String
  meta         String
  description  String

  @@unique([experienceId, locale])
}

// --------------------------------------------------------- About page ---------

// Singleton — bio, photo and section headings for the About page.
model AboutProfile {
  id             String                    @id @default(cuid())
  photoUrl       String?
  /// Sections the owner hid in the visual editor (AboutSectionKey values).
  hiddenSections String[]                  @default([])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  translations   AboutProfileTranslation[]
}

model AboutProfileTranslation {
  id                String       @id @default(cuid())
  aboutProfile      AboutProfile @relation(fields: [aboutProfileId], references: [id], onDelete: Cascade)
  aboutProfileId    String
  locale            Locale
  name              String
  photoCaption      String       @default("")
  bioHtml           String
  experienceHeading String
  projectsHeading   String
  stackHeading      String
  hobbiesHeading    String

  @@unique([aboutProfileId, locale])
}

// -------------------------------------------------------------- Stack ---------

model StackCategory {
  id           String                     @id @default(cuid())
  sortOrder    Int                        @default(0)
  published    Boolean                    @default(true)
  items        String[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  translations StackCategoryTranslation[]
}

model StackCategoryTranslation {
  id              String        @id @default(cuid())
  stackCategory   StackCategory @relation(fields: [stackCategoryId], references: [id], onDelete: Cascade)
  stackCategoryId String
  locale          Locale
  title           String

  @@unique([stackCategoryId, locale])
}

// ------------------------------------------------------------- Hobbies --------

model HobbyCard {
  id           String                 @id @default(cuid())
  handle       String
  url          String                 @default("")
  imageUrl     String?
  sortOrder    Int                    @default(0)
  published    Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations HobbyCardTranslation[]
}

model HobbyCardTranslation {
  id          String    @id @default(cuid())
  hobbyCard   HobbyCard @relation(fields: [hobbyCardId], references: [id], onDelete: Cascade)
  hobbyCardId String
  locale      Locale
  title       String
  description String

  @@unique([hobbyCardId, locale])
}

// ------------------------------------------------------- Visual editor --------

// Singleton (id "site") — the CRM visual editor's working copy
// (docs/visual-editor.md §3). `tree` is the edited SiteTree (both locales),
// `base` the published tree it forked from. The content tables stay the
// published copy; publishing writes `tree` into them and deletes the row.
model ContentDraft {
  id        String   @id @default("site")
  tree      Json
  base      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- SEO ---------

model SeoMeta {
  id          String   @id @default(cuid())
  page        SeoPage
  locale      Locale
  title       String
  description String
  keywords    String[]
  ogImageUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, locale])
}

// --------------------------------------------------------------- Leads --------

model Lead {
  id         String     @id @default(cuid())
  name       String
  contact    String
  message    String
  status     LeadStatus @default(new)
  note       String?
  sourcePath String     @default("/")
  locale     Locale     @default(ru)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------------- Media --------

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
