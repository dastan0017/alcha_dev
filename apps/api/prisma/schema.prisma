// alcha.dev — Prisma schema.
// Translation-table pattern: a base row + `*Translation` rows keyed by locale,
// with a unique (parentId, locale). Every orderable entity has `sortOrder`,
// every publishable one a `published` flag, and timestamps everywhere.

generator client {
  provider = "prisma-client-js"
  // Without an explicit target, `prisma generate` emits an engine for the BUILD platform
  // only, and the container dies at its first query with
  // "Query engine library ... could not be found".
  //   native     — local dev on darwin-arm64
  //   debian-*   — the node:22-bookworm-slim image on the current x86 host (CPX22)
  //   linux-arm64-* — kept ready for the planned move to an ARM host (CAX11) once
  //                   Hetzner has stock; carrying both costs ~15 MB and makes that
  //                   migration a no-op instead of a crash-at-first-query.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ru
  en
}

enum LeadStatus {
  new
  in_progress
  paid
  closed
}

enum ProjectBadge {
  work // client / work project
  own // own product (gets the gradient treatment)
}

enum UserRole {
  ADMIN
}

enum SeoPage {
  home
}

// ----------------------------------------------------------------- Auth ------

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               UserRole @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ------------------------------------------------------- Site settings --------

// Singleton — language-neutral contacts, socials, CV and analytics.
model SiteSettings {
  id              String   @id @default(cuid())
  email           String   @default("hello@alcha.dev")
  telegram        String   @default("")
  whatsapp        String   @default("")
  github          String   @default("")
  linkedin        String   @default("")
  instagram       String   @default("")
  cvUrl           String   @default("")
  addressLocality String   @default("Bishkek")
  addressRegion   String   @default("Chuy")
  addressCountry  String   @default("KG")
  priceRange      String   @default("$300+")
  gaId            String?
  yandexMetrikaId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --------------------------------------------------------- Site chrome --------

// Singleton — nav, footer and shared button labels rendered on every page.
model SiteChrome {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations SiteChromeTranslation[]
}

model SiteChromeTranslation {
  id                    String     @id @default(cuid())
  siteChrome            SiteChrome @relation(fields: [siteChromeId], references: [id], onDelete: Cascade)
  siteChromeId          String
  locale                Locale
  navWorks              String     @default("")
  navPricing            String     @default("")
  navCta                String     @default("")
  /// Compact header CTA on narrow screens.
  navCtaShort           String     @default("")
  footerTagline         String     @default("")
  footerNavHeading      String     @default("")
  footerContactsHeading String     @default("")
  footerRights          String     @default("")
  footerMadeIn          String     @default("")
  /// Works card link, e.g. "Смотреть кейс".
  viewCaseLabel         String     @default("")
  /// Case-page breadcrumb back to the works list.
  allWorksLabel         String     @default("")
  backToHomeLabel       String     @default("")
  roleLabel             String     @default("")
  stackLabel            String     @default("")
  whatWasDoneLabel      String     @default("")

  @@unique([siteChromeId, locale])
}

// ---------------------------------------------------- Home editorial ----------

// Singleton — hero, section headings and the shared dark CTA banner.
model HomeContent {
  id             String                   @id @default(cuid())
  published      Boolean                  @default(true)
  /// Sections the owner hid in the visual editor (HomeSectionKey values).
  hiddenSections String[]                 @default([])
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  translations   HomeContentTranslation[]
}

model HomeContentTranslation {
  id                     String      @id @default(cuid())
  homeContent            HomeContent @relation(fields: [homeContentId], references: [id], onDelete: Cascade)
  homeContentId          String
  locale                 Locale
  eyebrow                String
  heroTitle              String
  heroSubtitle           String
  heroSubtitleMobile     String      @default("")
  heroBullets            String[]
  heroNote               String      @default("")
  heroCtaPrimary         String
  heroCtaSecondary       String
  processEyebrow         String      @default("")
  processHeading         String
  processSubheading      String      @default("")
  processPill            String      @default("")
  processFromLabel       String      @default("")
  processResultLabel     String      @default("")
  processMainLabel       String      @default("")
  processAnnotationLabel String      @default("")
  processAnnotationText  String      @default("")
  worksEyebrow           String      @default("")
  worksHeading           String
  worksLede              String      @default("")
  pricingEyebrow         String      @default("")
  pricingHeading         String
  pricingNote            String
  /// Label before each plan's example businesses, e.g. «Например:».
  pricingExamplesLabel   String      @default("")
  /// Prefix of each optional add-on, e.g. «По желанию:».
  pricingOptionalLabel   String      @default("")
  /// Payment terms under the cards — the only place the section states them.
  pricingFootnote        String      @default("")
  ctaTitle               String
  ctaSubtitle            String
  ctaTelegramLabel       String
  ctaWhatsappLabel       String

  @@unique([homeContentId, locale])
}

// ------------------------------------------------------- Process steps --------

// The homepage «Процесс и услуги» timeline. A step's number is its position.
model ProcessStep {
  id           String                   @id @default(cuid())
  sortOrder    Int                      @default(0)
  published    Boolean                  @default(true)
  /// The one highlighted step: purple circle and border, badge and the annotation under it.
  isMain       Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations ProcessStepTranslation[]
}

model ProcessStepTranslation {
  id          String      @id @default(cuid())
  step        ProcessStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId      String
  locale      Locale
  title       String
  description String
  /// «ОТ ВАС» — what the step needs from the client.
  from        String      @default("")
  /// «РЕЗУЛЬТАТ» — what the step delivers.
  result      String      @default("")

  @@unique([stepId, locale])
}

// ------------------------------------------------------------ Projects --------

model Project {
  id           String               @id @default(cuid())
  slug         String               @unique
  badgeType    ProjectBadge
  sortOrder    Int                  @default(0)
  showOnHome   Boolean              @default(false)
  published    Boolean              @default(false)
  /// Case-page screenshots `[{ src, device: 'desktop' | 'mobile' }]`; `[0]` is the hero shot,
  /// the rest the «Экраны» gallery. Captions are per-locale, in `screenshotCaptions`.
  screenshots  Json                 @default("[]")
  coverImage   String?
  /// Link-preview picture shown in the «Ссылка в мессенджере» bubble; blank falls back to the og-image.
  shareImage   String?
  /// «Админка: тексты и фото» pictures, in order; captions are in `editingCaptions`.
  editingImages String[]
  /// «Админка: заявки» picture; its caption is `requestsCaption`.
  requestsImage String?
  /// Project the «Следующий проект» card points at. A plain id, not a foreign key: a deleted
  /// or unpublished target falls back to the next project by sort order rather than blocking the delete.
  nextProjectId String              @default("")
  /// Meta-strip values. Stored but not rendered — the strip comes back once both are real.
  durationWeeks String             @default("")
  launchedAt    String             @default("")
  /// Store pages of a shipped app; blank hides the link on the card.
  appStoreUrl   String              @default("")
  googlePlayUrl String              @default("")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]

  @@index([sortOrder])
}

model ProjectTranslation {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  locale         Locale
  title          String
  badge          String
  /// Product-type tag on the works card, e.g. "СОБСТВЕННЫЙ ПРОДУКТ" (empty = hidden).
  typeTag        String   @default("")
  metaLine       String
  /// ✓ facts on the works card: `[{ lead?, text }]`, `lead` is the bold opening phrase.
  facts          Json     @default("[]")
  role           String   @default("")
  description    String
  pills          String[]
  /// Bullet list of the classic case page; the detailed one uses `siteFeatures` instead.
  bullets        String[]
  /// «01 · Что умеет сайт» rows `[{ title, text }]`. Non-empty turns on the detailed case layout.
  siteFeatures   Json     @default("[]")
  /// Caption under each `Project.screenshots` entry, same index.
  screenshotCaptions String[]
  /// «02 · Админка: тексты и фото».
  editingTitle   String   @default("")
  editingLead    String   @default("")
  editingPoints  Json     @default("[]")
  /// Caption under each `Project.editingImages` entry, same index.
  editingCaptions String[]
  /// «03 · Админка: заявки».
  requestsTitle  String   @default("")
  requestsLead   String   @default("")
  requestsPoints Json     @default("[]")
  /// The status row in order, e.g. «Новая → В работе → Оплачена → Закрыта».
  requestsStatuses String[]
  requestsCaption String  @default("")
  /// «Проверьте сами» line: `**bold**` renders bold, `[text]` opens the request form.
  proofLine      String   @default("")
  /// «Сервер и надёжность» columns `[{ title, text }]`.
  reliability    Json     @default("[]")
  techChips      String[]
  seoTitle       String   @default("")
  seoDescription String   @default("")

  @@unique([projectId, locale])
}

// ------------------------------------------------------------- Pricing --------

model PricingPlan {
  id           String                   @id @default(cuid())
  sortOrder    Int                      @default(0)
  highlighted  Boolean                  @default(false)
  published    Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations PricingPlanTranslation[]
}

model PricingPlanTranslation {
  id             String      @id @default(cuid())
  plan           PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  locale         Locale
  name           String
  priceLabel     String
  /// Timing only, e.g. «1–2 НЕДЕЛИ»: payment terms live in the section footnote.
  termLine       String
  highlightLabel String      @default("")
  /// Who the plan is for.
  description    String
  /// Example businesses after the «Например:» label.
  examples       String      @default("")
  /// Heading of the feature list, e.g. «Всё из «Лендинга», плюс:».
  listHeading    String      @default("")
  features       String[]
  /// Optional add-ons listed after the features with a «+» and the «По желанию:» label.
  extras         String[]    @default([])
  /// The card button, e.g. «Обсудить лендинг».
  ctaLabel       String      @default("")

  @@unique([planId, locale])
}

// ------------------------------------------------------- Visual editor --------

// Singleton (id "site") — the CRM visual editor's working copy
// (docs/visual-editor.md §3). `tree` is the edited SiteTree (both locales),
// `base` the published tree it forked from. The content tables stay the
// published copy; publishing writes `tree` into them and deletes the row.
model ContentDraft {
  id        String   @id @default("site")
  tree      Json
  base      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- SEO ---------

model SeoMeta {
  id          String   @id @default(cuid())
  page        SeoPage
  locale      Locale
  title       String
  description String
  keywords    String[]
  ogImageUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, locale])
}

// --------------------------------------------------------------- Leads --------

model Lead {
  id         String     @id @default(cuid())
  name       String
  contact    String
  message    String
  status     LeadStatus @default(new)
  note       String?
  sourcePath String     @default("/")
  locale     Locale     @default(ru)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------------- Media --------

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
