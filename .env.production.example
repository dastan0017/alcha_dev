# =============================================================================
# alcha.dev — PRODUCTION environment. Copy to /opt/alcha/.env on the server.
#
#   NEVER commit the filled-in version. The repo is public.
#
# Generate every secret with:  openssl rand -base64 48
# =============================================================================

# ------------------------------------------------------------------ Postgres --
POSTGRES_USER=alcha
POSTGRES_PASSWORD=            # openssl rand -base64 32  (no @ : / characters — see below)
POSTGRES_DB=alcha
# Host is the compose service name, not localhost. If the password contains
# @ : / ? or #, URL-encode it here or Prisma will misparse the URL.
DATABASE_URL=postgresql://alcha:PASSWORD_HERE@postgres:5432/alcha?schema=public&connection_limit=5&pool_timeout=10

# ----------------------------------------------------------------------- API --
NODE_ENV=production
PORT=4000

# Must be regenerated — the dev defaults are published in .env.example.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PREVIEW_TOKEN_TTL=2h

# EXACT string match, no wildcards, no trailing slashes. Apex and www are
# different origins and both must be listed, or the browser gets an opaque CORS
# error. An empty value here silently blocks every browser request.
CORS_ORIGINS=https://alcha.dev,https://www.alcha.dev,https://admin.alcha.dev

# --------------------------------------------------------- ISR revalidation --
REVALIDATE_SECRET=
# Where the API POSTs revalidation webhooks.
WEB_URL=https://alcha.dev

# ------------------------------------------------------------ Seed admin ----
# Used ONCE by ./seed-once.sh. seed-once.sh refuses to run with the default.
SEED_ADMIN_EMAIL=hello@alcha.dev
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- AWS S3 ----
# MUST be present but EMPTY for real AWS. If the line is missing entirely, the
# zod schema substitutes http://localhost:9000 and the API silently mints
# presigned URLs pointing at its own loopback.
S3_ENDPOINT=
S3_REGION=eu-north-1
S3_BUCKET=
# MUST be the literal string false. Blank fails the zod enum and the API will not
# boot at all. 'False' and '0' are equally invalid.
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Read origin for uploaded objects. This value is CONCATENATED INTO MediaAsset.url
# rows at upload time, so changing it later is a data migration, not a config edit.
S3_PUBLIC_URL=https://BUCKET.s3.eu-north-1.amazonaws.com

# -------------------------------------------------- Telegram (optional) -----
# Leave empty to disable; the integration no-ops on an empty token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------- Web (build) --
# These are INLINED INTO THE BUNDLE at build time. Changing one requires a full
# rebuild — `docker compose up -d` with a new value does nothing.
NEXT_PUBLIC_SITE_URL=https://alcha.dev
NEXT_PUBLIC_API_URL=https://api.alcha.dev
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Origin allowed to drive the draft-preview bridge. Must match the CRM's real
# origin exactly, including scheme — a mismatch silently drops every message and
# the visual editor loads a blank iframe with no error.
CRM_URL=https://admin.alcha.dev

# ------------------------------------------------------------- CRM (build) --
VITE_API_URL=https://api.alcha.dev
VITE_SITE_URL=https://alcha.dev
